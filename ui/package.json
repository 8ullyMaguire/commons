{
  "name": "commons-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js dev",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "check": "node_modules/.bin/svelte-check --threshold error",
    "test": "node ./tests/run-tests.mjs",
    "test:e2e": "node_modules/.bin/playwright test",
    "verify": "pnpm run build && pnpm run check && pnpm run test && pnpm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.21.5",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10"
  }
}
